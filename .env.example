# Copie para .env.local e preencha os valores.
# NUNCA commite arquivos .env/.env.local (mesmo em repositório privado).

# Modo do app: "production" (web/Vercel) ou "local" (rede interna)
VITE_APP_MODE=production

# Supabase (obrigatório)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY

# URL pública do app (usada para links de recuperação e redirects)
VITE_APP_URL=https://seu-app.vercel.app
# (Opcional) URL explícita de redirect para recuperação de senha
VITE_SUPABASE_REDIRECT=https://seu-app.vercel.app/reset-password

# Gemini API (obrigatório para IA: chat/voz/relatórios)
# Aceita: GEMINI_API_KEY, VITE_GEMINI_API_KEY ou API_KEY
GEMINI_API_KEY=SUA_GEMINI_API_KEY

# Monitoramento de erros (opcional, recomendado)
# Use a URL DSN do projeto no Sentry (ex: https://xxx@xxx.ingest.sentry.io/xxx).
# NÃO cole o comando do wizard (npx @sentry/wizard...) aqui.
VITE_SENTRY_DSN=

# Supabase server-only (G7-A Server Adapter / API). NUNCA VITE_* para service role.
# SUPABASE_URL pode omitir se VITE_SUPABASE_URL já estiver definido no runtime server.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SUPABASE_SERVICE_ROLE_KEY

# --- SENTINELA API v1 (server-side ONLY — nunca VITE_*) ---
# Credentials HMAC (JSON array). Cada client_id é scoped a 1 org + 1 condo.
# SENTINELA_API_CREDENTIALS=[{"client_id":"n8n-pilot","secret":"troque-me","organization_id":"0e5a5c4b-4cc6-48ee-8c1b-08d5015ab928","condominium_id":"3f383313-5ec0-4d21-97c7-1b2500c933be","role_name":"porteiro","permission_keys":["packages.create","packages.update","residents.view"]}]
# Catálogo de tenants para validação fail-closed sem round-trip (opcional em piloto/testes).
# Em produção preferir SELECT em organizations/condominiums (M1/M4) via service role.
# SENTINELA_TENANT_CATALOG=[{"organization_id":"0e5a5c4b-4cc6-48ee-8c1b-08d5015ab928","condominium_id":"3f383313-5ec0-4d21-97c7-1b2500c933be"}]
# Janela anti-replay do timestamp (segundos), default 300
# SENTINELA_API_TIMESTAMP_WINDOW_SECONDS=300
#
# Credencial futura n8n (G7-F) — guardar no vault do n8n / secrets do servidor.
# NÃO commitar valores reais. NÃO usar VITE_*. Mapear no servidor via SENTINELA_API_CREDENTIALS.
# SENTINELA_N8N_CLIENT_ID=
# SENTINELA_N8N_SECRET=
# SENTINELA_N8N_ORGANIZATION_ID=
# SENTINELA_N8N_CONDOMINIUM_ID=

# Envio de e-mail de convite (Convidar por link) — configurar no Vercel
# Use a mesma API Key do Resend que está no Supabase (Authentication → E-mails → SMTP).
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remetente: use o MESMO Sender email do Supabase; domínio deve estar verificado no Resend (Domains).
RESEND_FROM=Qualivida <no-reply@phmsdev.com.br>

# (Opcional) Em desenvolvimento local: URL do backend para onde /api é proxiada (ex: sua URL na Vercel).
# Se não definir, em dev o proxy usa http://localhost:3001 — rode "npm run dev:api" para servir a API.
# VITE_API_BASE_URL=https://seu-app.vercel.app

# --- Master FASE C (server-side ONLY — nunca VITE_*) ---
# E-mails de sócios para provisionamento posterior. NÃO colocar senhas aqui.
# NÃO commitar e-mails reais. NÃO usar no frontend.
# PLATFORM_OWNER_EMAILS=socio1@example.com,socio2@example.com
# Script (não executa sozinho): node scripts/provision-platform-owners.mjs
# Requer SUPABASE_SERVICE_ROLE_KEY somente no ambiente server-side seguro.