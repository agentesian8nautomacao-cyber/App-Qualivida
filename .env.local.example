# Rede local do condomínio — copie para .env.local e preencha (override em qualquer modo).
# Para dev/build na rede interna use: npm run dev:local / npm run build:local (modo localnet; carrega .env.localnet).

VITE_SUPABASE_URL=http://192.168.0.10:54321
VITE_SUPABASE_ANON_KEY=xxxx
VITE_APP_MODE=local
